# Core
POSTGRES_DB=after_ours
POSTGRES_USER=after_ours
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://after_ours:change-this-password@postgres:5432/after_ours
REDIS_URL=redis://redis:6379/0
APP_ENV=production
DEMO_MODE=false
LOG_LEVEL=INFO

# Web/API
FRONTEND_PORT=3200
BACKEND_PORT=8100
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://backend:8000
CORS_ORIGINS=http://localhost:3200

# Storage and processing
MEDIA_ROOT=/data/media
UPLOAD_MAX_MB=2048
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm,.m4v
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_VIDEO_CODEC=libx264
OUTPUT_AUDIO_CODEC=aac

# Optional integrations
YOUTUBE_API_KEY=
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=mock
ANALYSIS_PROVIDER=mock
YOUTUBE_PUBLISHING_CLIENT_ID=
YOUTUBE_PUBLISHING_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
